# --- Server ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://dsa:dsa_dev_password@localhost:5432/dsa_arcade?schema=public"

# --- Auth (CHANGE THESE IN PRODUCTION — use long random strings) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_1234567890
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_0987654321
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
COOKIE_SECURE=false

# The API talks only to the local, resource-limited execution service.
RUNNER_URL=http://127.0.0.1:4010
RUNNER_TOKEN=dev_runner_token_change_before_deploy_123456
